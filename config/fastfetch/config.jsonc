// ===========================================================================
//  Arc Reactor — fastfetch
//
//  Colours are the NAMED ansi colours (red/yellow/blue/...) on purpose: kitty
//  maps color1/3/4 to the Arc Reactor red/gold/cyan, so this readout inherits
//  the exact palette instead of hardcoding a second copy of it.
//
//  Logo is generated by ~/.arc-reactor/src/make_ascii_logo.py
// ===========================================================================
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/arc-reactor.txt",
    "padding": { "top": 2, "left": 2, "right": 4 }
  },

  "display": {
    "separator": "  ",
    "color": {
      "keys": "red",
      "title": "yellow"
    }
  },

  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[1;31m╭─ \u001b[1;33mA R C   R E A C T O R\u001b[0m \u001b[31m────────────────────────────\u001b[0m"
    },
    {
      "type": "title",
      "key": " ",
      "format": "  \u001b[1;37m{user-name}\u001b[0m\u001b[31m@\u001b[0m\u001b[1;36m{host-name}\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[31m│\u001b[0m"
    },

    { "type": "os",         "key": "  OS    ",     "keyColor": "red" },
    { "type": "kernel",     "key": "  KERNEL", "keyColor": "red" },
    { "type": "uptime",     "key": "󰅐  UPTIME", "keyColor": "red" },
    { "type": "packages",   "key": "  PKGS  ",   "keyColor": "red" },
    { "type": "shell",      "key": "  SHELL ",  "keyColor": "red" },

    {
      "type": "custom",
      "format": "\u001b[31m│\u001b[0m"
    },

    { "type": "de",         "key": "  DE    ",     "keyColor": "yellow" },
    { "type": "wm",         "key": "  WM    ",     "keyColor": "yellow" },
    { "type": "theme",      "key": "  THEME ",  "keyColor": "yellow" },
    { "type": "icons",      "key": "󰀻  ICONS ",  "keyColor": "yellow" },
    { "type": "font",       "key": "  FONT  ",   "keyColor": "yellow" },
    { "type": "terminal",   "key": "  TERM  ",   "keyColor": "yellow" },

    {
      "type": "custom",
      "format": "\u001b[31m│\u001b[0m"
    },

    { "type": "cpu",        "key": "  CORE  ",   "keyColor": "blue",
      "showPeCoreCount": true },
    { "type": "gpu",        "key": "  GPU   ",    "keyColor": "blue" },
    { "type": "memory",     "key": "  MEMORY", "keyColor": "blue" },
    { "type": "swap",       "key": "󰓣  SWAP  ",   "keyColor": "blue" },
    { "type": "disk",       "key": "󰋊  DISK  ",   "keyColor": "blue" },
    { "type": "battery",    "key": "  POWER ",  "keyColor": "blue" },
    { "type": "display",    "key": "󰍹  SCREEN", "keyColor": "blue" },

    {
      "type": "custom",
      "format": "\u001b[31m╰────────────────────────────────────────────────\u001b[0m"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 3
    },
    "break"
  ]
}
